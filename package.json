{
  "name": "gratitude-agents",
  "version": "2.0.0",
  "private": true,
  "description": "Gratitude.com AI agent chat platform — 14 marketing + design agents with shared knowledgebase",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:checks",
    "test:checks": "tsx --test checks/*.test.ts",
    "smoke:exports": "tsx checks/smoke-exports.ts",
    "eval": "tsx evals/run.ts",
    "eval:mock": "tsx evals/run.ts --mock",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@clerk/nextjs": "^7.9.3",
    "@napi-rs/canvas": "^0.1.94",
    "@neondatabase/serverless": "^0.10.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@vercel/blob": "^2.6.1",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.38.3",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "next": "^15.3.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.30.5",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
